#pragma code_page(65001)
// prompt_editor.rc
// VS2022 Resource Script (UTF-8)

#include "resource.h"
#include "afxres.h"

/////////////////////////////////////////////////////////////////////////////
// Main Dialog
/////////////////////////////////////////////////////////////////////////////
IDD_PROMPT_EDITOR_DIALOG DIALOGEX 0, 0, 520, 640
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "prompt_editor — スペック駆動MDジェネレーター"
FONT 9, "MS UI Gothic", 400, 0, 0x80
BEGIN
    LTEXT           "プロジェクト名：", IDC_STATIC, 10, 10, 70, 10
    EDITTEXT        IDC_EDIT_PROJECT_NAME, 85, 8, 200, 14, ES_AUTOHSCROLL

    LTEXT           "目的：",           IDC_STATIC, 10, 28, 70, 10
    EDITTEXT        IDC_EDIT_PURPOSE,   85, 26, 420, 14, ES_AUTOHSCROLL

    LTEXT           "担当者：",         IDC_STATIC, 10, 46, 70, 10
    EDITTEXT        IDC_EDIT_OWNER,     85, 44, 100, 14, ES_AUTOHSCROLL

    GROUPBOX        "プラットフォーム", IDC_STATIC, 8, 62, 504, 34
    AUTORADIOBUTTON "C#/WinForms",  IDC_RADIO_WINFORMS, 18, 74, 75, 14, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "C#/WPF",       IDC_RADIO_WPF,      98, 74, 55, 14
    AUTORADIOBUTTON "C++/MFC",      IDC_RADIO_MFC,      158, 74, 60, 14
    AUTORADIOBUTTON "C++/Win32",    IDC_RADIO_WIN32,    223, 74, 65, 14
    AUTORADIOBUTTON "Web(HTML/CSS/JS)", IDC_RADIO_WEB,  293, 74, 90, 14

    CONTROL         "", IDC_TAB_MAIN, "SysTabControl32",
                    TCS_TABS | WS_TABSTOP, 8, 102, 504, 470

    LTEXT           "出力先：", IDC_STATIC, 10, 582, 40, 10
    EDITTEXT        IDC_EDIT_OUTPUT_PATH, 55, 580, 360, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "参照...", IDC_BUTTON_BROWSE, 420, 578, 50, 16

    DEFPUSHBUTTON   "生成", IDC_BUTTON_GENERATE, 380, 602, 60, 16
    PUSHBUTTON      "閉じる", IDC_BUTTON_CLOSE,  445, 602, 60, 16
END


/////////////////////////////////////////////////////////////////////////////
// Tab: Requirements
/////////////////////////////////////////////////////////////////////////////
IDD_TAB_REQUIREMENTS DIALOGEX 0, 0, 498, 500
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_VSCROLL
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "ゴール：",               IDC_STATIC, 6,   6,  60, 10
    EDITTEXT        IDC_EDIT_GOAL,             70,  4, 420, 40,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "ターゲットユーザー：",   IDC_STATIC, 6,  50,  80, 10
    EDITTEXT        IDC_EDIT_TARGET_USER,      90, 48, 400, 30,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "解決したい課題：",       IDC_STATIC, 6,  84,  80, 10
    EDITTEXT        IDC_EDIT_PROBLEM,          90, 82, 400, 40,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "成功の定義：",           IDC_STATIC, 6, 130,  60, 10
    EDITTEXT        IDC_EDIT_SUCCESS_CRITERIA, 70,128, 420, 40,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "In Scope：",             IDC_STATIC, 6, 176,  60, 10
    EDITTEXT        IDC_EDIT_IN_SCOPE,         70,174, 420, 30,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Out of Scope：",         IDC_STATIC, 6, 212,  80, 10
    EDITTEXT        IDC_EDIT_OUT_SCOPE,        90,210, 400, 30,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END


/////////////////////////////////////////////////////////////////////////////
// Tab: Design
/////////////////////////////////////////////////////////////////////////////
IDD_TAB_DESIGN DIALOGEX 0, 0, 498, 500
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_VSCROLL
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "技術スタック補足：",     IDC_STATIC, 6,   6,  80, 10
    EDITTEXT        IDC_EDIT_TECH_STACK,       90,  4, 400, 30,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "命名規則：",             IDC_STATIC, 6,  40,  60, 10
    EDITTEXT        IDC_EDIT_NAMING_RULES,     70, 38, 420, 50,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "コーディング規約：",     IDC_STATIC, 6,  96,  80, 10
    EDITTEXT        IDC_EDIT_CODING_RULES,     90, 94, 400, 50,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "データフロー：",         IDC_STATIC, 6, 152,  60, 10
    EDITTEXT        IDC_EDIT_DATA_FLOW,        70,150, 420, 60,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "外部依存：",             IDC_STATIC, 6, 220,  60, 10
    EDITTEXT        IDC_EDIT_EXTERNAL_DEPS,    70,218, 420, 30,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
END


/////////////////////////////////////////////////////////////////////////////
// Tab: Tasks
/////////////////////////////////////////////////////////////////////////////
IDD_TAB_TASKS DIALOGEX 0, 0, 498, 500
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_VSCROLL
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "フェーズ1 追加タスク：", IDC_STATIC, 6,   6, 100, 10
    EDITTEXT        IDC_EDIT_TASKS_PHASE1,    110,  4, 380, 80,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "フェーズ2 追加タスク：", IDC_STATIC, 6,  92, 100, 10
    EDITTEXT        IDC_EDIT_TASKS_PHASE2,    110, 90, 380, 80,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "フェーズ3 実装タスク：", IDC_STATIC, 6, 178, 100, 10
    EDITTEXT        IDC_EDIT_TASKS_PHASE3,    110,176, 380, 100,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "※ 各タスクは「- [ ] タスク内容」形式で入力",
                    IDC_STATIC, 6, 282, 300, 10
END


/////////////////////////////////////////////////////////////////////////////
// Tab: CLAUDE.md
/////////////////////////////////////////////////////////////////////////////
IDD_TAB_CLAUDE DIALOGEX 0, 0, 498, 500
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_VSCROLL
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "追加する基本指示：",     IDC_STATIC, 6,   6, 100, 10
    EDITTEXT        IDC_EDIT_CLAUDE_BASIC,    110,  4, 380, 130,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "追加する禁止事項：",     IDC_STATIC, 6, 142, 100, 10
    EDITTEXT        IDC_EDIT_CLAUDE_PROHIBITED, 110,140, 380, 130,
                    ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP

    LTEXT           "※ 標準の指示・禁止事項はテンプレートから自動挿入されます",
                    IDC_STATIC, 6, 280, 400, 10
END


/////////////////////////////////////////////////////////////////////////////
// Tab: Preview
/////////////////////////////////////////////////////////////////////////////
IDD_TAB_PREVIEW DIALOGEX 0, 0, 498, 500
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "MS UI Gothic"
BEGIN
    LTEXT           "表示ファイル：", IDC_STATIC, 6, 8, 60, 10
    COMBOBOX        IDC_COMBO_PREVIEW_FILE, 70, 6, 220, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIT_PREVIEW_CONTENT, 6, 24, 486, 470,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
END
